  "scripts": {
    "start": "nx serve --project angular-typed-writer",
    "prepare": "npm run build",
    "lint:affected": "nx affected -t lint",
    "test:affected": "nx affected -t test",
    "build:affected": "nx affected -t build",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "deploy:demo": "nx run angular-typed-writer:deploy --base-href=https://skyzerozx.github.io/ngx-typed-writer/",
    "release": "VERSION=$VERSION npm run update-versions && npm run build && nx run-many -t publish",
    "bump-version:root": "rjp package.json version $VERSION"
  },
